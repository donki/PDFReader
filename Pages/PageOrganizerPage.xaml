<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:PDFReader.Pages"
             x:Class="PDFReader.Pages.PageOrganizerPage"
             Style="{StaticResource AppPage}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="16,16,16,8">
            <VerticalStackLayout Padding="18,12" Spacing="2">
                <Label x:Name="TitleLabel" Style="{StaticResource CardTitle}" LineBreakMode="MiddleTruncation" MaxLines="1" />
                <Label x:Name="HintLabel" Style="{StaticResource SecondaryText}" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <!-- Miniaturas: se tocan para seleccionar; el borde de marca marca las elegidas. -->
        <CollectionView Grid.Row="1"
                        x:Name="PagesView"
                        Margin="12,4"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:PageThumbnail">
                    <Border Style="{StaticResource Card}"
                            Stroke="{Binding Outline}"
                            StrokeThickness="{Binding OutlineThickness}">
                        <Grid RowDefinitions="*,Auto" Padding="6" RowSpacing="4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPageTapped" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Row="0"
                                   Source="{Binding Image}"
                                   Rotation="{Binding Rotation}"
                                   Aspect="AspectFit"
                                   HeightRequest="150" />
                            <Label Grid.Row="1"
                                   Text="{Binding Label}"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Acciones sobre la seleccion: seleccionar todo, girar, mover, borrar; y guardar. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="8,4,8,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="6,4" ColumnSpacing="2">
                <Button Grid.Column="0" x:Name="SelectAllButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_select_all.png, Dark=ic_select_all_dark.png}" Clicked="OnSelectAllClicked" />
                <Button Grid.Column="1" x:Name="RotateLeftButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_rotate_left.png, Dark=ic_rotate_left_dark.png}" Clicked="OnRotateLeftClicked" />
                <Button Grid.Column="2" x:Name="RotateRightButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_rotate_right.png, Dark=ic_rotate_right_dark.png}" Clicked="OnRotateRightClicked" />
                <Button Grid.Column="3" x:Name="MoveUpButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_arrow_up.png, Dark=ic_arrow_up_dark.png}" Clicked="OnMoveUpClicked" />
                <Button Grid.Column="4" x:Name="MoveDownButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_arrow_down.png, Dark=ic_arrow_down_dark.png}" Clicked="OnMoveDownClicked" />
                <Button Grid.Column="5" x:Name="DeleteButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="{AppThemeBinding Light=ic_trash.png, Dark=ic_trash_dark.png}" Clicked="OnDeleteClicked" />
                <Button Grid.Column="7" x:Name="SaveButton" Style="{StaticResource ReaderToolButton}"
                        ImageSource="ic_save_dark.png" BackgroundColor="{StaticResource PdfPrimary}" Clicked="OnSaveClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="BusyOverlay" IsVisible="False" BackgroundColor="{StaticResource ScrimOverlay}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="14">
                <ActivityIndicator IsRunning="True" Color="{StaticResource White}" HorizontalOptions="Center" />
                <Label x:Name="BusyLabel" TextColor="{StaticResource White}" FontSize="14" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
