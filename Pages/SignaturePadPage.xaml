<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDFReader.Pages.SignaturePadPage"
             Style="{StaticResource AppPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <Label x:Name="TitleLabel" Style="{StaticResource CardTitle}" />
            <Label x:Name="HintLabel" Style="{StaticResource SecondaryText}" />
        </VerticalStackLayout>

        <!-- Lienzo blanco, como un papel; la linea de abajo es la de la firma. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BackgroundColor="White">
            <Grid>
                <BoxView HeightRequest="1" Color="#B0B4C0" VerticalOptions="End" Margin="24,0,24,40" />
                <GraphicsView x:Name="Pad"
                              StartInteraction="OnStart"
                              DragInteraction="OnDrag"
                              EndInteraction="OnEnd" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="ClearButton" Style="{StaticResource ReaderToolButton}"
                    ImageSource="{AppThemeBinding Light=ic_trash.png, Dark=ic_trash_dark.png}" Clicked="OnClearClicked" />
            <Button Grid.Column="2" x:Name="CancelButton" Style="{StaticResource ReaderToolButton}"
                    ImageSource="{AppThemeBinding Light=ic_close.png, Dark=ic_close_dark.png}" Clicked="OnCancelClicked" />
            <Button Grid.Column="3" x:Name="AcceptButton" Style="{StaticResource ReaderToolButton}"
                    ImageSource="ic_check_dark.png" BackgroundColor="{StaticResource PdfPrimary}" Clicked="OnAcceptClicked" />
        </Grid>
    </Grid>
</ContentPage>
