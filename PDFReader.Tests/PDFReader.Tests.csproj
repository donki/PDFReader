<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas de PDF Reader (constitucion General 8.6). La app es un proyecto MAUI de un solo
       proyecto: aqui se enlaza todo su codigo salvo el de Platforms/ (servicios, modelos, paginas con
       su XAML, App y MauiProgram) y se compila para net10.0 con Microsoft.Maui.Controls (MIT), que
       funciona sin dispositivo ni handlers. Lo que depende del dispositivo pasa por
       Services/AppPlatform.cs y aqui lo sustituyen dobles (Fakes.cs); el renderizado nativo
       (PdfRenderer de Android, Windows.Data.Pdf) lo sustituye un documento de mentira sobre
       PdfDocumentBase, que es donde estan las reglas comunes. FileSystem.AppDataDirectory y
       Preferences, los dobles de Stubs/. Nada sale de las carpetas temporales ni a la red. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PDFReader.Tests</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <!-- Los dobles de FileSystem/Preferences tapan a los de MAUI a proposito. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit y su runner (Apache-2.0), Microsoft.NET.Test.Sdk y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Codigo de la app que se prueba (enlazado, no copiado): todo menos Platforms/. -->
  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\obj\**;..\bin\**;..\Platforms\**;..\PDFReader.Tests\**;..\constitution\**" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="..\**\*.xaml" Exclude="..\obj\**;..\bin\**;..\Platforms\**;..\PDFReader.Tests\**;..\constitution\**" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Piezas comunes (repo sOCShared) que usa la app; no cuentan en la cobertura (coverlet.runsettings). -->
    <Compile Include="..\..\Shared\AuthorNotes.cs" Link="Shared\AuthorNotes.cs" />
    <Compile Include="..\..\Shared\ModernDialog.cs" Link="Shared\ModernDialog.cs" />
    <Compile Include="..\..\Shared\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
  </ItemGroup>

</Project>
