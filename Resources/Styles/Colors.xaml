<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta unica de la aplicacion, con nombres semanticos (por rol, sin prefijo de app:
        el diccionario ya delimita el ambito). Rojo PDF como color de marca, superficies neutras.
        Todo color de superficie o de texto se declara por pares claro/oscuro y se consume con
        AppThemeBinding (constitucion, seccion 24).
        Nota Android: ver tambien Platforms\Android\Resources\values\colors.xml.
    -->

    <!-- Marca -->
    <Color x:Key="Primary">#3525CD</Color>
    <Color x:Key="PrimaryDark">#2A1CB8</Color>
    <Color x:Key="Accent">#4F46E5</Color>

    <!-- Estado -->
    <Color x:Key="Legal">#BA1A1A</Color>

    <!-- Velo modal: oscurece la pantalla tras un overlay o un dialogo propio. -->
    <Color x:Key="ScrimOverlay">#99000000</Color>

    <!-- Superficies -->
    <Color x:Key="PageBackgroundLight">#F8F9FA</Color>
    <Color x:Key="PageBackgroundDark">#141318</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#201F27</Color>
    <Color x:Key="CanvasLight">#EDEEEF</Color>
    <Color x:Key="CanvasDark">#2A2833</Color>
    <Color x:Key="BorderLight">#C7C4D8</Color>
    <Color x:Key="BorderDark">#48454F</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryLight">#191C1D</Color>
    <Color x:Key="TextPrimaryDark">#E6E1E9</Color>
    <Color x:Key="TextSecondaryLight">#464555</Color>
    <Color x:Key="TextSecondaryDark">#C7C4D8</Color>

    <!-- Neutros -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>
