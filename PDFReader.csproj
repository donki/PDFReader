<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android36.0</TargetFrameworks>
    <!-- Windows solo se compila desde Windows: el destino WinUI no existe en otros sistemas. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PDFReader</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>PDF Editor</ApplicationTitle>

    <!-- App Identifier (constitucion seccion 4: com.socratic.[nombre-aplicacion]) -->
    <ApplicationId>com.socratic.pdfreader</ApplicationId>

    <!-- Versions (constitucion seccion 6) -->
    <ApplicationDisplayVersion>2026.09.12.1</ApplicationDisplayVersion>
    <ApplicationVersion>2026091201</ApplicationVersion>

    <!-- Accept Android SDK Licenses -->
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>

    <!-- Package Information -->
    <PackageId>PDFReader</PackageId>
    <Title>PDF Editor</Title>
    <Product>PDF Editor</Product>
    <Description>Lector y editor de PDF para Android y Windows: sin conexion, sin permisos y con los documentos siempre en el dispositivo</Description>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>pdf;reader;viewer;android;maui;dotnet</PackageTags>
    <Authors>Socratic</Authors>
    <Company>Socratic</Company>

    <!-- Platform versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Android specific -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <AssemblyVersion>2026.07.15.0</AssemblyVersion>
    <FileVersion>2026.07.15.0</FileVersion>
  </PropertyGroup>

  <!-- Windows: sin empaquetar (MSIX) durante el desarrollo; el exe arranca directamente. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <!-- Release configuration for Android -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>false</AndroidKeyStore>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon. Indigo unificado (#3525CD): el rediseño del 28-jul cambió los SVG pero se dejó
         aquí el rojo de la marca anterior, que asomaba de fondo en el splash. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3525CD" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3525CD" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Las mismas fuentes, tambien como recurso: PDFsharp escribe con ellas (PdfFontResolver).
         Open Sans (OFL), Lora (OFL, serif), Roboto Mono (Apache 2.0) y Caveat (OFL, manuscrita). -->
    <MauiAsset Include="Resources\Fonts\*.ttf" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- Herramientas de documento (fusionar, dividir, rotar, imagenes a PDF, contraseñas, marcas
         de agua, anotaciones aplanadas): PDFsharp escribe PDF y es MIT (constitucion, seccion 4).
         El renderizado sigue siendo el nativo de cada plataforma. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <!-- Ficheros compartidos por las 7 apps (una sola fuente de verdad). Se perdieron en el
       incidente de reorganizacion: sin ellos el proyecto no compila, porque las paginas usan
       SocShared.ModernDialog. -->
  <ItemGroup>
    <Compile Include="..\Shared\AuthorNotes.cs" Link="AuthorNotes.cs" />
    <Compile Include="..\Shared\ModernDialog.cs" Link="ModernDialog.cs" />
  </ItemGroup>

  <!-- Firma Release centralizada (constitucion 7), igual que en las otras 6 apps. Define
       AndroidKeyStore=true y el formato aab, por lo que manda sobre la seccion de Release
       de mas arriba. Se perdio en el incidente de reorganizacion. -->
  <Import Project="..\Shared\signing.props" />

</Project>
